NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Web origins allowed to call the API and the socket (comma separated, no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Neon (or any) PostgreSQL connection string. Use the pooled one for production.
DATABASE_URL=postgres://chatz:chatz@127.0.0.1:5432/chatz_dev
DATABASE_POOL_MAX=10
# Apply SQL migrations when the server starts (safe with several instances).
AUTO_MIGRATE=true

# Supabase: used for email OTP login only
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Only if your project still signs tokens with the legacy shared secret (HS256):
# SUPABASE_JWT_SECRET=

# Random string, 32+ characters. Signs the temporary links used to open chat attachments.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_URL_SECRET=

# Neon object storage (S3 compatible). Leave empty to disable photo and file uploads.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=
S3_FORCE_PATH_STYLE=true
# proxy: files stream through this API (works everywhere). presign: browser downloads straight from the bucket.
STORAGE_DELIVERY=proxy

# Number of reverse proxies in front of the API (Render/Railway/Fly: 1)
TRUST_PROXY=0
