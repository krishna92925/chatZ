# URL of the chatZ API (no trailing slash)
VITE_API_URL=http://localhost:4000
# Supabase project (Authentication > API). The publishable key is safe in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Length of the email code (Supabase default is 6)
VITE_OTP_LENGTH=6
